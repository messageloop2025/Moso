# 默认：所有文本文件检出时 LF
* text=auto eol=lf

# 源码文件强制 LF
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.vue text eol=lf
*.txt text eol=lf

# Windows 批处理文件保留 CRLF（CMD 需要）
*.bat text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.so binary
*.whl binary
*.mp4 binary
*.webm binary
*.svg binary
