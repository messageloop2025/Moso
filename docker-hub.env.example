# Copy to docker-hub.env and set your Docker Hub username (do not commit docker-hub.env)
# Save this file as ANSI or UTF-8 without BOM if edit on Windows Notepad.

DOCKERHUB_USER=your_dockerhub_username
DOCKERHUB_REPO=moso

# Tag for root docker-compose.yml (default latest)
# MOSO_IMAGE_TAG=1.3.8-sp1

# Set PUSH_LATEST=0 to skip pushing :latest in publish-docker-hub.bat
# PUSH_LATEST=1

# Production (optional)
# EDGEOPS_SECRET=change-me-in-production
